@model List<Ticket>
@using ITHelpdeskTicketSystem.Models.Enums
@{
    ViewData["Title"] = "Tickets";
}
<h1>All Tickets</h1>
<h5>@ViewBag.Message</h5>
<form method="get" class="d-flex gap-2 mb-3">
    <select name="priority" class="form-select" asp-items="Html.GetEnumSelectList<TicketPriority>()">
        <option value="">All priorities</option>
    </select>
    <input type="text" name="search" id="searchBox" value="@ViewBag.Search" class="form-control mb-3" placeholder="Search..." />
    <button type="submit"id="btnSearch">Search</button>
</form>
<table class="table table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Created On</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Ticket ti in Model)
        {
            <tr>
                <td>@ti.Id</td>
                <td>@ti.Title</td>
                <td><span class="priority-badge priority-@ti.Priority.ToString().ToLower()">@ti.Priority</span></td>
                <td><span class="status-badge status-@ti.Status.ToString().ToLower()">@ti.Status</span></td>
                <td>@ti.CreatedOn.ToString("dd MMM yyyy")</td>
                <td>@ti.GetDetails()</td>
            </tr>
        }
    </tbody>
</table>
    
