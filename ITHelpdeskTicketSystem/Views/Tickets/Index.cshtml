@model List<Ticket>
@{
    ViewData["Title"] = "Tickets";
}
<h5>All Tickets</h5>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Created On</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Ticket ti in Model)
        {
            <tr>
                <td>@ti.Id</td>
                <td>@ti.Title</td>
                <td><span class="priority-badge priority-@ti.Priority.ToString().ToLower()">@ti.Priority</span></td>
                <td><span class="status-badge status-@ti.Status.ToString().ToLower()">@ti.Status</span></td>
                <td>@ti.CreatedOn.ToString("dd MMM yyyy")</td>
                @if (ti is SoftwareTicket st)
                {
                    <td>@st.ApplicationName</td>
                }
                else if (ti is HardwareTicket ht)
                {
                    <td>@ht.AssetTag</td>
                }
                else if(ti is AccessRequestTicket art)
                {
                    <td>@art.SystemName</td>
                }
                else
                {
                    <td></td>
                }
            </tr>
        }
    </tbody>
</table>
    
