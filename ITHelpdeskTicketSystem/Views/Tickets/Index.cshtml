@model List<Ticket>
@using ITHelpdeskTicketSystem.Models.Enums
@{
    ViewData["Title"] = "Tickets";
}

<h6>@ViewBag.PageTitle</h6>

@if (TempData["SuccessMessage"] is string msg)
{
    <span class="SuccessMessage">@msg</span>
}

<div class="d-flex justify-content-between p-2">
    <div class="float-start">
        <h1>All Tickets</h1>
    </div>
    <div class="float-end">
        <a asp-action="Create" class="btn btn-primary">Create</a>
    </div>
</div>
<h5 class="message-viewbag">@ViewBag.Message</h5>

<form method="get" class="row p-2">
    <div class="form-group col-lg-5">
        <select name="priority" class="form-select" asp-items="Html.GetEnumSelectList<TicketPriority>()">
            <option value="">All priorities</option>
        </select>
    </div>
    <div class="form-group col-lg-5">
        <input type="text" name="search" id="searchBox" value="@ViewBag.Search" class="form-control mb-3" placeholder="Search..." />
    </div>
    <div class="col-lg-2 text-end">
        <button type="submit" id="btnSearch" class="btn btn-secondary">Search</button>
    </div>
</form>

<table class="table table-hover p-2">
    <thead>
        <tr>
            <th></th>
            <th>Id</th>
            <th>Title</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Created On</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Ticket ti in Model)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-route-id="@ti.Id"><i class="bi bi-eye"></i></a>
                    <a asp-action="Edit" asp-route-id="@ti.Id"> <i class="bi bi-pencil-square"></i></a>
                    <form asp-action="Delete" asp-route-id="@ti.Id" method="post" class="d-inline">
                        <button class="btn btn-link p-0 text-danger" title="Delete"
                                onclick="return confirm('Delete this ticket?')">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
                <td>@ti.Id</td>
                <td>@ti.Title</td>
                <td><span class="priority-badge priority-@ti.Priority.ToString().ToLower()">@ti.Priority</span></td>
                <td><span class="status-badge status-@ti.Status.ToString().ToLower()">@ti.Status</span></td>
                <td>@ti.CreatedOn.ToString("dd MMM yyyy")</td>
                <td>@ti.GetDetails()</td>
            </tr>
        }
    </tbody>
</table>
    
